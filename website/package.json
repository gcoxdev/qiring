{
  "name": "qiring-website",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "sync:help": "node scripts/sync-help.mjs",
    "check:help": "node scripts/sync-help.mjs --check",
    "screenshots": "node scripts/capture-app.mjs",
    "test": "playwright test"
  },
  "dependencies": { "astro": "7.3.8" },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "parse5": "8.0.1"
  }
}
